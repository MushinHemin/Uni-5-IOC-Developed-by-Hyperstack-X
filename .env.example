# Uni 5 example environment file.
# Copy this file to .env for local development and change the values.

PORT=3200
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Bootstrap only: required when ADMIN_ACCOUNT does not exist.
# Use a unique password of at least 12 characters; existing credentials are never overwritten.
# Changing this value does NOT reset an existing account. Use the authorized password-reset flow.
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
ADMIN_USERNAME=Administrator
